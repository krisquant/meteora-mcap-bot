# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Solana RPC endpoint (optional, defaults to public mainnet)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Webhook URL (required for Vercel/serverless, leave empty for polling mode)
# For Vercel, this will be: https://your-project.vercel.app
WEBHOOK_URL=

# Port (only used for local development with polling)
PORT=3000
